rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // User accounts — each user manages their own profile. The `verified`
    // field mirrors Firebase Auth's real emailVerified flag (synced by
    // client code on sign-in) but a user cannot set verified:true directly
    // themselves — Firestore rules can't call Auth APIs, so this checks that
    // the incoming value matches what's already stored unless it's the
    // account's own first-time creation (verified defaults to false there).
    match /users/{uid} {
      allow read: if request.auth != null &&
                    (request.auth.uid == uid || request.auth.token.email == 'doni@admin.com');
      allow create: if request.auth != null && request.auth.uid == uid &&
                    request.resource.data.verified == false;
      allow update: if request.auth != null && request.auth.uid == uid &&
                    (request.resource.data.verified == resource.data.verified ||
                     request.resource.data.verified == request.auth.token.email_verified);
    }

    // Admin-only dashboard settings (site title/desc/status/tags/updates note)
    match /dashboard/settings {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email == 'doni@admin.com';
    }

    // Contact form submissions — private. Anyone can submit one, only admin can read/delete.
    match /messages/{doc} {
      allow create: if request.resource.data.message is string
                    && request.resource.data.email is string;
      allow read, delete: if request.auth != null && request.auth.token.email == 'doni@admin.com';
    }

    // Live visitor chat — public, separate collection from contact messages above.
    // Banned/muted sessions are blocked from creating new messages at the rules
    // level (not just hidden in the UI) via a lookup against bannedSessions.
    match /chatMessages/{doc} {
      allow read: if true;
      allow create: if request.resource.data.text is string
                    && request.resource.data.text.size() <= 500
                    && request.resource.data.name is string
                    && request.resource.data.name.size() <= 20
                    && request.resource.data.sessionId is string
                    && !exists(/databases/$(database)/documents/bannedSessions/$(request.resource.data.sessionId))
                    && !exists(/databases/$(database)/documents/mutedSessions/$(request.resource.data.sessionId))
                    // Anonymous messages (no uid) are unrestricted, same as before accounts existed.
                    // Signed-in-but-unverified accounts are capped at 10 messages total.
                    // Signed-in-verified accounts are unrestricted.
                    && (!('uid' in request.resource.data)
                        || request.auth.token.email_verified == true
                        || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.messageCount < 10);
      // Reactions require a verified account (or anonymous — reactions never carried
      // a verification requirement for anonymous visitors, only signed-in-unverified
      // accounts are blocked here since they explicitly opted into an account).
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])
                    && (request.auth == null || request.auth.token.email_verified == true);
      allow delete: if request.auth != null && request.auth.token.email == 'doni@admin.com';
    }

    // Banned sessions — admin-only to write, but readable by anyone so the
    // client can show an honest "you are banned" state instead of messages
    // silently failing to send.
    match /bannedSessions/{sessionId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email == 'doni@admin.com';
    }

    // Muted sessions — same model as bans but lighter (can still read chat).
    match /mutedSessions/{sessionId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email == 'doni@admin.com';
    }

    // Message reports — anyone can file one, only admin can read/manage them.
    match /reports/{doc} {
      allow create: if request.resource.data.messageId is string
                    && request.resource.data.reporterSessionId is string;
      allow read, delete: if request.auth != null && request.auth.token.email == 'doni@admin.com';
    }

    // Polls created via the /poll chat command
    match /polls/{doc} {
      allow read: if true;
      allow create: if request.resource.data.question is string;
      allow update: if request.resource.data.diff(resource.data).affectedKeys()
                      .hasOnly(['votes', 'voters']);
      allow delete: if request.auth != null && request.auth.token.email == 'doni@admin.com';
    }

    // Blog posts / changelog entries published via the admin Posts tab —
    // public read, admin-only write.
    match /posts/{doc} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email == 'doni@admin.com';
    }

    // Guestbook — public signing, admin can moderate
    match /guestbook/{doc} {
      allow read: if true;
      allow create: if request.resource.data.message is string
                    && request.resource.data.message.size() <= 300
                    && request.resource.data.name is string
                    && request.resource.data.name.size() <= 50;
      allow update, delete: if request.auth != null && request.auth.token.email == 'doni@admin.com';
    }

    // Presence collection for the live visitor counter
    match /presence/{doc} {
      allow read: if true;
      allow write: if true;
    }

    // Analytics (page view counters)
    match /analytics/{doc} {
      allow read: if true;
      allow write: if true;
    }

    // Legacy/unused collections — kept open, nothing in the code currently writes to these.
    match /short_urls/{doc} {
      allow read, write: if true;
    }
    match /typing_leaderboard/{doc} {
      allow read, write: if true;
    }
    match /heatmap_clicks/{doc} {
      allow read, write: if true;
    }

    // Deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
